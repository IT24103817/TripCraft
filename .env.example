# Copy to .env and fill in values locally. Never commit .env.
DATABASE_URL=
JWT_SECRET=
JWT_ISSUER=
INTERNAL_AGENT_KEY=
AGENT_SERVICE_URL=
ORS_API_KEY=
OWM_API_KEY=
ALLOWED_ORIGINS=
AGENT_CALLBACK_BASE_URL=
FX_FALLBACK_LKR_PER_USD=
# Optional: override a provider's base URL (e.g. an unreachable host to test the fallbacks).
FX_API_BASE_URL=
ORS_API_BASE_URL=
OWM_API_BASE_URL=
RUN_MIGRATIONS=
UPLOADS_DIR=
# v1.1: HMAC key for voucher QR codes (random, at least 32 bytes). Required to confirm trips and scan vouchers.
VOUCHER_SIGNING_KEY=
# v1.1: a tourist may cancel until this many days before the start (default 3), then sees this contact.
CANCELLATION_CUTOFF_DAYS=
OPERATOR_CONTACT=
# v1.1: email. Without SMTP_HOST, emails are written as .eml files to EMAIL_PICKUP_DIR (default: temp/tripcraft-mail).
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
EMAIL_PICKUP_DIR=
# v1.1: the operator's time zone for "today" (cancellation cut-off, voucher day check). Default Asia/Colombo.
OPERATOR_TIME_ZONE=
# v1.1: email through the Mailtrap sandbox HTTP API (fourth third-party integration). Without these, emails are
# written to EMAIL_PICKUP_DIR. MAIL_FROM is the sender address; MAILTRAP_API_BASE_URL only to test the fallback.
MAILTRAP_API_TOKEN=
MAILTRAP_INBOX_ID=
MAIL_FROM=
MAILTRAP_API_BASE_URL=
