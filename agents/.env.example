# Copy to agents/.env and fill in locally. Never commit .env.
INTERNAL_AGENT_KEY=
API_BASE_URL=http://localhost:5080
# ollama (local), groq (hosted) or gemini (optional). Unset: groq on Render (RENDER=true), ollama elsewhere.
LLM_PROVIDER=ollama
OLLAMA_MODEL=llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_NUM_PREDICT=1536
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
RATE_LIMIT_RETRIES=3
RATE_LIMIT_BACKOFF_SECONDS=2
# 20 is enough locally; hosted Groq uses 60 with NODE_TIMEOUT_SECONDS=90 (render.yaml).
RATE_LIMIT_MAX_WAIT_SECONDS=20
# Optional (free tier: 20 requests a day):
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
NODE_TIMEOUT_SECONDS=30
MAX_RETRIES=2
MAX_REPLANS=3
